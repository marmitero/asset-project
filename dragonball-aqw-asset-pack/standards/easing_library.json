{
  "version": "1.0.0",
  "default": "smoothstep",
  "forbidden_on_limbs": ["linear"],
  "curves": {
    "linear": {"type": "linear"},
    "ease_in_quad": {"type": "power", "power": 2, "direction": "in"},
    "ease_out_quad": {"type": "power", "power": 2, "direction": "out"},
    "ease_in_out_quad": {"type": "power", "power": 2, "direction": "in_out"},
    "ease_in_cubic": {"type": "power", "power": 3, "direction": "in"},
    "ease_out_cubic": {"type": "power", "power": 3, "direction": "out"},
    "ease_in_out_cubic": {"type": "power", "power": 3, "direction": "in_out"},
    "smoothstep": {"type": "cubic_hermite", "p0": 0.0, "p1": 0.0, "p2": 1.0, "p3": 1.0},
    "ease_out_back": {"type": "back", "overshoot": 1.70158, "direction": "out"},
    "ease_in_back": {"type": "back", "overshoot": 1.70158, "direction": "in"},
    "ease_out_elastic": {"type": "elastic", "amplitude": 1.0, "period": 0.35},
    "ease_out_bounce": {"type": "bounce", "bounces": 3},
    "hold": {"type": "constant"},
    "catmull": {"type": "catmull_rom", "tension": 0.5}
  },
  "usage": {
    "anticipation": "ease_out_quad",
    "strike": "ease_in_cubic",
    "impact_hold": "hold",
    "recovery": "ease_out_back",
    "breathing": "ease_in_out_quad",
    "foot_lift": "ease_out_quad",
    "foot_plant": "ease_in_quad",
    "death_fall": "ease_out_bounce",
    "hit_recoil": "ease_out_elastic",
    "camera_shake": "ease_out_quad",
    "trajectory": "catmull"
  },
  "springs": {
    "hair_back": {"stiffness": 0.55, "damping": 0.22, "delay_frames": 2, "max_angle_deg": 18},
    "hair_back_long": {"stiffness": 0.65, "damping": 0.18, "delay_frames": 2, "max_angle_deg": 24},
    "cape": {"stiffness": 0.40, "damping": 0.18, "delay_frames": 3, "max_angle_deg": 32},
    "tail": {"stiffness": 0.50, "damping": 0.20, "delay_frames": 2, "max_angle_deg": 26},
    "obi": {"stiffness": 0.60, "damping": 0.25, "delay_frames": 1, "max_angle_deg": 14},
    "antenna": {"stiffness": 0.70, "damping": 0.30, "delay_frames": 1, "max_angle_deg": 10}
  },
  "rules": {
    "max_angular_velocity_deg_per_frame": 38,
    "max_jitter_deg_per_frame2": 3,
    "min_spacing_variation_pct": 20,
    "loop_seam_max_deg": 0.5,
    "loop_seam_max_px": 0.5,
    "foot_slip_max_px": 1.0
  }
}
